% doc.sty: the preamble of the suite results document (DESIGN-DOC §4). Fonts from TeX Live (no system fonts),
% the outcome glyphs from DejaVu Sans, the colours of §3.1, the cell and block macros the generator emits.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{doc}[2026/10/15 suite results document]
\RequirePackage[a4paper,margin=18mm,headheight=14pt]{geometry}
\RequirePackage{fontspec}
\RequirePackage{xcolor}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{multicol}
\RequirePackage{needspace}
\RequirePackage{microtype}
\RequirePackage{fancyhdr}
\RequirePackage[breakable,skins]{tcolorbox}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usepgfplotslibrary{statistics}
\RequirePackage[hidelinks,bookmarksnumbered=false,pdfusetitle]{hyperref}

\setmainfont{LibertinusSerif-Regular.otf}[BoldFont=LibertinusSerif-Bold.otf,ItalicFont=LibertinusSerif-Italic.otf,BoldItalicFont=LibertinusSerif-BoldItalic.otf]
\setsansfont{FiraSans-Regular.otf}[BoldFont=FiraSans-Bold.otf,ItalicFont=FiraSans-Italic.otf,BoldItalicFont=FiraSans-BoldItalic.otf]
\setmonofont{FiraMono-Regular.otf}[Scale=0.88,BoldFont=FiraMono-Bold.otf]
\newfontfamily\glyphfont{DejaVuSans.ttf}

\definecolor{okgreen}{HTML}{2E7D32}
\definecolor{failred}{HTML}{C62828}
\definecolor{findorange}{HTML}{EF6C00}
\definecolor{incgrey}{HTML}{607D8B}
% red means "needs attention" (the owner's decision of 2026-10-16): a test not implemented via MCP (the glyph, its
% counts, class words and marks) and the attention tags of the contents and of I.1 are set in it
\definecolor{attnred}{HTML}{C62828}
\definecolor{bdblue}{HTML}{1565C0}
% the tints of a printed execution time (the cell grammar's times line; cells.TIME_TINT_YELLOW_MS / _RED_MS):
% light backgrounds that stay legible in print, black text on both
\definecolor{timeyellow}{HTML}{FFE866}
\definecolor{timered}{HTML}{FF8A80}

% the outcome glyphs (§3.1)
\newcommand\gpass{\leavevmode{\mdseries\upshape\glyphfont\color{okgreen}\symbol{"25CF}}}
\newcommand\gfail{\leavevmode{\mdseries\upshape\glyphfont\color{failred}\symbol{"2716}}}
\newcommand\gfind{\leavevmode{\mdseries\upshape\glyphfont\color{findorange}\symbol{"25B2}}}
\newcommand\ginc{\leavevmode{\mdseries\upshape\glyphfont\color{incgrey}\symbol{"25D0}}}
\newcommand\gni{\leavevmode{\mdseries\upshape\glyphfont\color{attnred}\symbol{"25CB}}}
\newcommand\gbd{\leavevmode{\mdseries\upshape\glyphfont\color{bdblue}\symbol{"25C6}}}
\newcommand\gerr{\leavevmode{\mdseries\upshape\glyphfont\color{failred}\symbol{"2298}}}
\newcommand\gnone{\leavevmode{\color{black!50}--}}
\newcommand\gne{\leavevmode{\mdseries\upshape\glyphfont\scriptsize\color{failred}\symbol{"2260}}}
% the property-level mark not implemented via MCP (cells.ArmState.ni_marked): a small red ○ raised after the glyph of
% an MCP cell one of whose executions had a property check set aside by the manifest's mark (the owner's decision of
% 2026-10-16: red wherever printed)
\newcommand\gnip{\textsuperscript{\mdseries\upshape\glyphfont\scriptsize\color{attnred}\symbol{"25CB}}}
% marks: a footnote digit, a small letter after a glyph or a time
\newcommand\fn[1]{\textsuperscript{\scriptsize\color{failred}\textbf{#1}}}
\newcommand\tmark[1]{\textsuperscript{\scriptsize #1}}
% the tint behind a printed execution time above a threshold (cells.tinted): a box of the figure's own width
% (no padding; it reaches 0.4 pt into the neighbouring side bearings), the height of a line of the current size,
% so that a tinted time sets exactly where an untinted one would and the pagination does not move
\newcommand\timetint[2]{{\setlength\fboxsep{0pt}\kern-0.4pt\colorbox{#1}{\color{black}\vphantom{Ag}\kern0.4pt\relax#2\kern0.4pt}\kern-0.4pt}}
\newcommand\tyellow[1]{\timetint{timeyellow}{#1}}
\newcommand\tred[1]{\timetint{timered}{#1}}
% a needs-attention text (cells.attn, latex's attention marker): a not-implemented-via-MCP count, mark or class word,
% an attention tag; red text, no other change of the font
\newcommand\attn[1]{\leavevmode{\color{attnred}#1}}
% the attention tag of a chapter in the table of contents (sections.toc_attention): a line of its own under the
% chapter's line, indented with the chapter's title, linked to the chapter
\newcommand\tocattention[2]{\par\nobreak\vspace{-2pt}{\leftskip=1.5em\rightskip=2.55em plus 1fil\noindent\small\sffamily\hyperref[#1]{\attn{#2}}\par}\addvspace{2pt}}
% headings of a unit and its property line
\newcommand\unithead[3]{\par\medskip\noindent\textbf{\texttt{#1}}\quad #2\hfill{\small\itshape #3}\par\nopagebreak}
\newcommand\propline[1]{\noindent{\small #1}\par\nopagebreak\smallskip}
% a family or chapter summary line
\newcommand\sumline[1]{\par\noindent{\sffamily\footnotesize #1}\par\medskip}
% detail blocks: a short block is one unbreakable box (moved whole to the next page when it does not fit), a
% long block breaks and repeats the test id in its title on every continuation
\tcbset{detailstyle/.style={enhanced,colback=black!4,colframe=black!35,boxrule=0.4pt,arc=1pt,
  left=4pt,right=4pt,top=3pt,bottom=3pt,before skip=4pt,after skip=8pt,fontupper=\footnotesize,
  coltitle=black,colbacktitle=black!10,fonttitle=\footnotesize\sffamily,titlerule=0pt,toptitle=1.5pt,bottomtitle=1.5pt}}
\newtcolorbox{detailshort}[1][]{detailstyle,unbreakable,#1}
\newtcolorbox{detaillong}[1][]{detailstyle,breakable,#1}
\newcommand\bline[2]{\par\noindent\hangindent=22mm\hangafter=1\makebox[22mm][l]{\sffamily\bfseries #1}#2}
\newcommand\bsub[2]{\par\noindent\hangindent=38mm\hangafter=1\hspace*{6mm}\makebox[32mm][l]{\sffamily #1}#2}
% the evidence of a finding, set apart from an allowed 503: an orange rule in the margin and the word FINDING
\newcommand\findingline[1]{\par\smallskip\noindent{\color{findorange}\rule[-1pt]{2pt}{9pt}}\hspace{4pt}%
  \begin{minipage}[t]{\dimexpr\linewidth-6pt-2pt\relax}\raggedright{\sffamily\bfseries\color{findorange}\gfind\ FINDING}\quad #1\end{minipage}\par\smallskip}
% the cover: the run verdict and the deploy gate, two boxes of equal weight
\newcommand\coverbox[2]{\noindent\begin{tcolorbox}[enhanced,colback=black!3,colframe=black!45,boxrule=0.5pt,arc=1pt,
  left=6pt,right=6pt,top=4pt,bottom=4pt,width=\linewidth,before skip=4pt,after skip=4pt]
  {\sffamily\small\color{black!60}#1}\par\smallskip{\sffamily #2}\end{tcolorbox}}
% a numbered marker on the annotated matrix of the reading guide
\newcommand\amark[1]{\textsuperscript{\sffamily\bfseries\color{findorange}(#1)}}
% the sample note under the title
\newcommand\samplenote[1]{\begin{center}{\sffamily\large\color{findorange}#1}\end{center}}
% a line of the check catalogue (appendix A): a bold key in the margin, hanging text, small type
\newcommand\catline[2]{\par\noindent\hangindent=24mm\hangafter=1\makebox[24mm][l]{\small\sffamily\bfseries #1}{\small #2}}
% the same with a key too wide for the margin (a route list): the key on its own line, the text indented under it
\newcommand\catblock[2]{\par\noindent{\small\sffamily\bfseries #1}\par\nopagebreak{\leftskip=24mm\noindent\small #2\par}}
% a small heading inside an appendix (a group of catalogue entries)
\newcommand\grouphead[1]{\par\medskip\noindent{\sffamily\bfseries #1}\par\nopagebreak\smallskip}
% a run-in heading of Part I, a chapter page or an appendix, kept with what follows it (never at a page's bottom)
\newcommand\parhead[1]{\par\medskip\Needspace{5\baselineskip}\noindent{\bfseries #1}\par\nopagebreak\smallskip}
% a continuation line of a detail block, aligned with the text column of \bline
\newcommand\bcont[1]{\par\noindent\hangindent=22mm\hangafter=0{}#1}
% a line of the annotated matrix's key: the marker in the margin, hanging text
\newcommand\annline[2]{\par\noindent\hangindent=9mm\hangafter=1\makebox[9mm][l]{\amark{#1}}#2}

% justified prose holds monospace identifiers and URLs: let a line stretch rather than overflow
\tolerance=400
\emergencystretch=3em
\setcounter{secnumdepth}{-1}
\setcounter{tocdepth}{2}
\setlength{\parskip}{3pt plus 1pt}
\setlength{\parindent}{0pt}
\pagestyle{fancy}
\fancyhf{}
\lhead{\small\sffamily\docrunid}
\rhead{\small\sffamily\nouppercase{\rightmark}}
\cfoot{\small\thepage}
\renewcommand{\headrulewidth}{0.3pt}
% a \quad in a heading, with a plain twin for the PDF bookmarks
\newcommand\qd{\texorpdfstring{\quad}{ }}
