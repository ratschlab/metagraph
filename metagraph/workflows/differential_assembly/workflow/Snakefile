rule annotate_counts:
    input:
        graph=JOINT_GRAPH,
        sequences=expand(SAMPLE_FASTA_PATTERN, sample=SAMPLE_IDS),
        counts=expand(SAMPLE_COUNTS_PATTERN, sample=SAMPLE_IDS)
    output:
        columns=COLUMN_FILES,
        column_counts=COLUMN_COUNT_FILES
    threads: threads_for("annotate_counts")
    resources:
        mem_mb=mem_for("annotate_counts"),
        runtime=runtime_for("annotate_counts")
    params:
        outdir=str(COLUMN_DIR),
        mem_gb=buffer_for("annotate_counts"),
        threads_each=int(config.get("annotation_threads_each", 1)),
        tmpdir=str(TMP_DIR)
    log:
        str(LOG_DIR / "annotate_counts.log")
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.outdir:q} "$(dirname {log:q})" {params.tmpdir:q}
        {TIME} {METAGRAPH} annotate -v -i {input.graph:q} --anno-filename \
          --anno-type column --separately --count-kmers --parallel {threads} \
          --threads-each {params.threads_each} --mem-cap-gb {params.mem_gb} \
          --disk-swap {params.tmpdir:q} -o {params.outdir:q} {input.sequences:q} \
          > {log:q} 2>&1
        """


rule write_column_list:
    input:
        COLUMN_FILES,
        COLUMN_COUNT_FILES
    output:
        str(ANNOTATION_DIR / "columns.txt")
    run:
        Path(output[0]).parent.mkdir(parents=True, exist_ok=True)
        Path(output[0]).write_text("".join(f"{path}\n" for path in input[:len(COLUMN_FILES)]))


rule transform_count_annotation:
    input:
        columns=str(ANNOTATION_DIR / "columns.txt")
    output:
        INT_ROW_ANNOTATION
    threads: threads_for("transform_count_annotation")
    resources:
        mem_mb=mem_for("transform_count_annotation"),
        runtime=runtime_for("transform_count_annotation")
    params:
        outbase=INT_ROW_BASE,
        mem_gb=buffer_for("transform_count_annotation"),
        tmpdir=str(TMP_DIR)
    log:
        str(LOG_DIR / "transform_count_annotation.log")
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output:q})" "$(dirname {log:q})" {params.tmpdir:q}
        cat {input.columns:q} | {TIME} {METAGRAPH} transform_anno -v \
          --anno-type int_row_flat --parallel {threads} \
          --mem-cap-gb {params.mem_gb} --disk-swap {params.tmpdir:q} \
          -o {params.outbase:q} > {log:q} 2>&1
        """


rule make_diff_rules:
    input:
        manifest=config["samples"],
        columns=COLUMN_FILES
    output:
        str(RULE_DIR / "{comparison}.json")
    run:
        comparison = COMPARISONS[wildcards.comparison]
        in_samples, out_samples = comparison_samples(SAMPLES, comparison)
        document = make_diff_document(
            wildcards.comparison,
            sample_labels(in_samples),
            sample_labels(out_samples),
            ASSEMBLY_CONFIGS[wildcards.comparison],
        )
        write_diff_document(document, output[0])


def assembly_flags():
    flags = []
    if bool(OUTPUT_OPTIONS.get("enumerate", True)):
        flags.append("--enumerate")
    if bool(OUTPUT_OPTIONS.get("unitigs", False)):
        flags.append("--unitigs")
    prune_tips = int(OUTPUT_OPTIONS.get("prune_tips", 0))
    if prune_tips > 0:
        flags.extend(["--prune-tips", str(prune_tips)])
    if DUMP_PVALS:
        flags.append("--dump-pvals")
    return " ".join(flags)


def annotation_flags(wildcards):
    return " ".join(
        f"-a {shlex.quote(str(path))}" for path in annotators_for_comparison(wildcards)
    )


rule differential_assembly:
    input:
        graph=JOINT_GRAPH,
        rules=str(RULE_DIR / "{comparison}.json"),
        annotators=annotators_for_comparison
    output:
        fasta=ASSEMBLY_FASTA_PATTERN,
        pvals=ASSEMBLY_PVAL_PATTERN if DUMP_PVALS else []
    threads: threads_for("differential_assembly")
    resources:
        mem_mb=mem_for("differential_assembly"),
        runtime=runtime_for("differential_assembly")
    params:
        outbase=lambda wildcards: str(ASSEMBLY_DIR / wildcards.comparison),
        annotations=annotation_flags,
        flags=assembly_flags(),
        tmpdir=str(TMP_DIR)
    log:
        str(LOG_DIR / "differential_assembly" / "{comparison}.log")
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.fasta:q})" "$(dirname {log:q})" {params.tmpdir:q}
        {TIME} {METAGRAPH} assemble -v --parallel {threads} {params.flags} \
          {params.annotations} --diff-assembly-rules {input.rules:q} \
          --disk-swap {params.tmpdir:q} -o {params.outbase:q} {input.graph:q} \
          > {log:q} 2>&1
        """
