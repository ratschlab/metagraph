# The source revision a binary is built from (GPT review 7, finding 6): `metagraph --version` states the
# commit and whether the checkout differed from it, so that a deploy can check that a binary was built from
# the commit it is deployed as. Run by CMake in script mode, at configure time and at every build (the
# source_revision target), with
#   -DSOURCE_DIR=<the metagraph directory> -DOUTPUT=<the C++ source to write> [-DGIT_EXECUTABLE=<git>]
# It writes OUTPUT only when its text changes, so that an unchanged state recompiles nothing.
#
#   commit: `git rev-parse --verify HEAD`, else "unknown" (git absent, no checkout, or a checkout that does
#           not hold this source: SOURCE_DIR is not its metagraph/ directory tracking this script; a
#           tarball of the sources unpacked inside another repository would otherwise state that
#           repository's commit, R4 review N1)
#   state:  "dirty" when the checkout differs from the commit in anything the build can read:
#             - a tracked change anywhere in the repository, a submodule at another commit or with
#               changed content (`git status --porcelain --untracked-files=no`), or
#             - any file under src/ that git does not track, ignored ones included (`git ls-files
#               --others -- src`): CMake compiles every src/*.cpp it finds, and .gitignore's
#               `metagraph/**/build*` would hide e.g. an untracked src/x/build_y.cpp;
#           "clean" otherwise (untracked files elsewhere, such as build directories, are compiled by
#           nothing); "unknown" when git could not tell.

set(commit "unknown")
set(state "unknown")
set(git "${GIT_EXECUTABLE}")
if(NOT git)
  # (a variable of its own: find_program does not search for a -D variable, NOTFOUND or empty)
  find_program(source_revision_git git)
  set(git "${source_revision_git}")
endif()
if(git)
  # the checkout git finds holds this source: its metagraph/ directory, which tracks this script
  execute_process(COMMAND "${git}" -C "${SOURCE_DIR}" ls-files --error-unmatch --full-name
                          -- CMakeListsSourceRevision.cmake
                  RESULT_VARIABLE rc_own OUTPUT_VARIABLE own ERROR_QUIET
                  OUTPUT_STRIP_TRAILING_WHITESPACE)
  execute_process(COMMAND "${git}" -C "${SOURCE_DIR}" rev-parse --verify HEAD
                  RESULT_VARIABLE rc OUTPUT_VARIABLE head ERROR_QUIET
                  OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(rc_own EQUAL 0 AND own STREQUAL "metagraph/CMakeListsSourceRevision.cmake"
     AND rc EQUAL 0 AND head MATCHES "^[0-9a-f]+$")
    set(commit "${head}")
    # (--no-optional-locks: the build only reads the checkout, not even git's index refresh)
    execute_process(COMMAND "${git}" --no-optional-locks -C "${SOURCE_DIR}" status
                            --porcelain --untracked-files=no
                    RESULT_VARIABLE rc_tracked OUTPUT_VARIABLE tracked ERROR_QUIET)
    execute_process(COMMAND "${git}" -C "${SOURCE_DIR}" ls-files --others -- src
                    RESULT_VARIABLE rc_untracked OUTPUT_VARIABLE untracked ERROR_QUIET)
    if(rc_tracked EQUAL 0 AND rc_untracked EQUAL 0)
      if(tracked STREQUAL "" AND untracked STREQUAL "")
        set(state "clean")
      else()
        set(state "dirty")
      endif()
    endif()
  endif()
endif()

set(text "// Generated by CMakeListsSourceRevision.cmake at build time: do not edit
#include \"common/source_revision.hpp\"

namespace mtg {
namespace common {

const char* source_commit() { return \"${commit}\"; }
const char* source_state() { return \"${state}\"; }

} // namespace common
} // namespace mtg
")
set(old "")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" old)
endif()
if(NOT old STREQUAL text)
  file(WRITE "${OUTPUT}" "${text}")
endif()
